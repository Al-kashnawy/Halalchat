rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function member(cid) { return signedIn() && exists(/databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid)); }
    function owner(cid) { return signedIn() && get(/databases/$(database)/documents/communities/$(cid)).data.ownerId == request.auth.uid; }
    function admin(cid) { return owner(cid) || (member(cid) && get(/databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid)).data.role in ['admin','moderator','owner']); }

    match /users/{uid} {
      allow read: if self(uid);
      allow create, update: if self(uid);
      match /memberships/{cid} { allow read, write: if self(uid); }
      match /blocks/{otherUid} { allow read, write: if self(uid); }
    }

    match /communities/{cid} {
      allow read: if signedIn() && (resource.data.visibility == 'public' || member(cid) || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.memberCount == 1;
      allow update: if owner(cid)
        || (signedIn()
          && exists(/databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && !existsAfter(/databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid))) ;
      allow delete: if owner(cid);

      match /members/{uid} {
        allow read: if member(cid) || owner(cid) || self(uid);
        allow create: if (self(uid) && request.resource.data.status == 'active' && ((get(/databases/$(database)/documents/communities/$(cid)).data.visibility == 'public') || (request.resource.data.inviteCode is string && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)) && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.active == true && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.communityId == cid))) || (admin(cid) && request.resource.data.role in ['member','moderator','admin']);
        allow update: if owner(cid) || self(uid);
        allow delete: if owner(cid) || self(uid);
      }
      match /invites/{code} {
        allow read: if signedIn();
        allow create: if admin(cid) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if admin(cid);
      }
      match /channels/{channelId} {
        allow read: if member(cid) || owner(cid);
        allow create, update, delete: if admin(cid);
        match /messages/{mid} {
          allow read: if member(cid) || owner(cid);
          allow create: if member(cid) && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
          allow update, delete: if member(cid) && resource.data.uid == request.auth.uid;
        }
      }
    }

    match /threads/{tid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds && request.resource.data.memberIds.size() == 2 && !exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[0])/blocks/$(request.resource.data.memberIds[1])) && !exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[1])/blocks/$(request.resource.data.memberIds[0]));
      allow update, delete: if signedIn() && request.auth.uid in resource.data.memberIds;
      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/threads/$(tid)).data.memberIds;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/threads/$(tid)).data.memberIds && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 4000 && !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/threads/$(tid)).data.memberIds[0])/blocks/$(get(/databases/$(database)/documents/threads/$(tid)).data.memberIds[1])) && !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/threads/$(tid)).data.memberIds[1])/blocks/$(get(/databases/$(database)/documents/threads/$(tid)).data.memberIds[0]));
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.communityId is string && admin(request.resource.data.communityId) && request.resource.data.createdBy == request.auth.uid && request.resource.data.active == true;
      allow update, delete: if signedIn() && resource.data.communityId is string && admin(resource.data.communityId);
    }
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn() && request.auth.uid == resource.data.reporterId;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.reporterId;
    }
    match /events/{eid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /attendees/{uid} { allow read: if signedIn(); allow create, update, delete: if self(uid); }
    }
  }
}
