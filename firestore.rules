rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(communityId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    function isOwner(communityId) {
      return signedIn() &&
        get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(communityId);

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isMember(communityId));
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if request.auth.uid == uid || isOwner(communityId);
      }

      match /channels/{channelId} {
        allow read: if isMember(communityId);
        allow create, update: if isOwner(communityId);

        match /messages/{messageId} {
          allow read: if isMember(communityId);
          allow create: if isMember(communityId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000;
          allow update, delete: if isMember(communityId)
            && resource.data.uid == request.auth.uid;
        }
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn(); // Tighten to moderator-only before public launch.
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}